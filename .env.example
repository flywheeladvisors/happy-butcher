# Copy to .env.local for local dev; set the same values in Vercel project env vars. No real values here.

# OpenRouter (LLM) - chat agent model (Happy Butcher) and price extraction
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Tavily (search)
TAVILY_API_KEY=

# Firecrawl (scrape)
FIRECRAWL_API_KEY=

# Neon (database) - pooled connection string, server-side only
DATABASE_URL=

# Resend (email)
RESEND_API_KEY=
# Verified sender, or Resend's test sender while no domain is verified: Happy Butcher <onboarding@resend.dev>
RESEND_FROM_EMAIL=
# Where the Wednesday summary goes (with the test sender, must be your Resend account's email)
HOUSEHOLD_EMAIL=

# Weekly check endpoint: GitHub Actions sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Password for the whole app (browser prompt; any username). Required in production.
APP_PASSWORD=

# Public app URL, used for the "Ask the butcher" link in the Wednesday email (e.g. https://happy-butcher.vercel.app)
APP_URL=
# Optional per-agent model overrides (defaults: Hunter claude-haiku-4.5, Inspector and Scout claude-sonnet-5)
HUNTER_MODEL=
INSPECTOR_MODEL=
SCOUT_MODEL=
